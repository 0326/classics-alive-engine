{
  "name": "classics-alive-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "古籍活化游戏引擎：将古籍内容转化为可追溯的 Web 游戏。",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "content:validate": "node scripts/validate-content.mjs",
    "content:compile": "node scripts/compile-content.mjs",
    "content:report": "node scripts/content-report.mjs content/demo",
    "content:intake": "node scripts/import-source.mjs",
    "story:verify": "node scripts/verify-ink.mjs content/demo/stories/demo.ink",
    "story:canon": "node scripts/verify-canon.mjs content/demo/stories/demo.ink",
    "build:web": "npm run content:compile && vite build --config apps/web/vite.config.ts",
    "dev:web": "npm run content:compile && vite --config apps/web/vite.config.ts",
    "dev:studio": "npm run content:compile && vite --config apps/studio/vite.config.ts",
    "build:studio": "npm run content:compile && vite build --config apps/studio/vite.config.ts",
    "build:all": "npm run build:web && npm run build:studio",
    "build:budget": "node scripts/check-build-budget.mjs",
    "deploy:dry": "wrangler deploy --dry-run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-validator.mjs && node scripts/test-importer.mjs && tsx tests/historical-runner.test.ts && npm run story:verify && npm run story:canon",
    "lint": "node scripts/check-docs.mjs",
    "check": "npm run lint && npm run typecheck && npm run content:validate && npm run content:compile"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "wrangler": "^3.112.0"
  },
  "dependencies": {
    "inkjs": "^2.4.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.1.12"
  }
}
